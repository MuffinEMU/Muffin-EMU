<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Moved here from project.yml's INFOPLIST_KEY_UIFileSharingEnabled: that flat
	     build-setting merged correctly for LSSupportsOpeningDocumentsInPlace but
	     silently dropped UIFileSharingEnabled from the actual shipped Info.plist
	     (confirmed via PlistBuddy on a real built IPA - GENERATE_INFOPLIST_FILE +
	     INFOPLIST_FILE merging both keys identically in the generated pbxproj, but
	     xcodebuild's own merge step only carrying one of the two through). Void
	     hit this live: sideloaded via SideStore, no file-sharing folder in Files/
	     Finder at all, no way to move ROMs/keys/logs onto the device. Writing it
	     literally here sidesteps the merge entirely rather than trying to explain
	     the undocumented Xcode behavior. -->
	<!-- The floor, stated so the OS filters on it instead of the app crashing on launch: a 64-bit
	     device with Metal. iOS 15 (project.yml) is the real lower bound; every device that runs
	     it meets both. See docs/DEVICE_SUPPORT.md. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<!-- Schemes the JIT enabler setting asks canOpenURL about (App/JITEnabler.swift). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>stikdebug</string>
		<string>livecontainer</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Declares .muffinlyt/.muffinclr as real Uniform Types rather than leaving them as
	     plain JSON with a custom extension. Same merge mechanism as CFBundleIcons below -
	     this is a nested structure GENERATE_INFOPLIST_FILE's flat INFOPLIST_KEY_* scheme
	     cannot express, so it lives in this hand-written partial instead. UTTypeIdentifier
	     values match UTType(exportedAs:) in PreviewShowcase.swift's MuffinLayoutDocument/
	     MuffinColourDocument exactly - a mismatch here would leave those file pickers
	     working (they filter by the Swift-side UTType, not this plist) but the Files app
	     showing a generic document icon and name instead of "Muffin Layout"/"Muffin
	     Colours" for these two extensions. -->
	<!-- Wii U game files. Imported, not exported: MuffinEMU doesn't own these formats, it opens
	     them. Declaring them is what puts MuffinEMU under "Open with" and in the share sheet for
	     .wua, .wud, .wux and .rpx; ContentView.openSharedFile imports what arrives. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.muffinemu.wiiu.wua</string>
			<key>UTTypeDescription</key>
			<string>Wii U Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>wua</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.muffinemu.wiiu.disc</string>
			<key>UTTypeDescription</key>
			<string>Wii U Disc Image</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>wud</string>
					<string>wux</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.muffinemu.wiiu.rpx</string>
			<key>UTTypeDescription</key>
			<string>Wii U Executable</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>rpx</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.kiddreads.muffin.layout</string>
			<key>UTTypeDescription</key>
			<string>Muffin Layout</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>muffinlyt</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.kiddreads.muffin.colour</string>
			<key>UTTypeDescription</key>
			<string>Muffin Colours</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>muffinclr</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Lets Files/Mail/AirDrop offer "Open in Muffin" for these two extensions, and is
