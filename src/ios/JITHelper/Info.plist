<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>MuffinJITHelper</string>
	<key>CFBundleDisplayName</key>
	<string>MuffinEMU JIT</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- A classic app extension launched by the host through the private NSExtension API,
	     never from the share sheet (FALSEPREDICATE never matches). This point needs no
	     extra App ID, so a free sideloading account can install it. The principal class
	     handles the request and runs the device-link work in this second process. -->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
		<key>NSExtensionPrincipalClass</key>
		<string>MuffinJITHelperPrincipal</string>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>NSExtensionActivationRule</key>
			<string>FALSEPREDICATE</string>
		</dict>
	</dict>
</dict>
</plist>
