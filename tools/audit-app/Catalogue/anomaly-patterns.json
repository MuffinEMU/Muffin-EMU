{
 "schema": "muffinaudit.anomalies/1",
 "patterns": [
  {"id": "drawable_acquire", "contains": "failed to acquire next drawable", "severity": "fail", "subsystem": "render.present",
   "message": "The screen layer could not hand out a drawable: frames were lost."},
  {"id": "queue_replaced", "contains": "command queue replaced", "severity": "warn", "subsystem": "render.gpu",
   "message": "The Metal command queue had to be replaced after a GPU fault."},
  {"id": "gpu_recovery", "contains": "GPU recovery", "severity": "warn", "subsystem": "render.gpu",
   "message": "The core went through GPU recovery."},
  {"id": "page_fault", "contains": "page fault", "severity": "fail", "subsystem": "render.gpu",
   "message": "The GPU reported a page fault."},
  {"id": "command_buffer_failed", "contains": "command buffer failed", "severity": "fail", "subsystem": "render.gpu",
   "message": "A Metal command buffer finished with an error."},
  {"id": "throttled", "contains": "command buffers are still on the GPU", "severity": "info", "subsystem": "render.gpu",
   "message": "The GPU thread waited for the GPU to catch up (too many command buffers in flight)."},
  {"id": "video_stalled", "contains": "video stalled", "severity": "fail", "subsystem": "render.present",
   "message": "The core's stall watchdog reported the picture stalled."},
  {"id": "shader_compile", "contains": "failed to compile", "severity": "fail", "subsystem": "render.shader",
   "message": "A shader or pipeline failed to compile."},
  {"id": "shader_error", "contains": "shader error", "severity": "fail", "subsystem": "render.shader",
   "message": "The core logged a shader error."},
  {"id": "out_of_memory", "contains": "out of memory", "severity": "fail", "subsystem": "memory.pressure",
   "message": "The core ran out of memory."},
  {"id": "memory_warning", "contains": "memory warning", "severity": "warn", "subsystem": "memory.pressure",
   "message": "iOS sent a memory warning."},
  {"id": "texture_evict", "contains": "evict", "severity": "info", "subsystem": "render.texture.eviction",
   "message": "The core evicted textures to free memory."},
  {"id": "assert", "contains": "assert", "severity": "fail", "subsystem": "core.assert",
   "message": "The core logged an assertion."},
  {"id": "not_implemented", "contains": "not implemented", "severity": "info", "subsystem": "core.unimplemented",
   "message": "The guest used something the core does not implement."},
  {"id": "unsupported_api", "contains": "unsupported", "severity": "info", "subsystem": "core.unimplemented",
   "message": "The core reported an unsupported operation or format."},
  {"id": "invalid_parameter", "contains": "invalid", "severity": "info", "subsystem": "core.api",
   "message": "The core logged an invalid parameter (GX2, AX or VPAD call)."}
 ]
}
